# Sao chép thành .env.local rồi điền. Không có gì cũng chạy được ở chế độ phát triển.

# --- Địa chỉ & bảo mật (bắt buộc khi triển khai) ---
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=            # chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -base64 32

# --- Đăng nhập email (liên kết một lần). Production bắt buộc có SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HCE Research <no-reply@your-domain>"
ALLOWED_EMAIL_DOMAINS=         # tuỳ chọn: hce.edu.vn,hueuni.edu.vn (trống = mọi email)
ADMIN_EMAILS=                  # tuỳ chọn: email quản trị, cách nhau bằng dấu phẩy

# --- Đăng nhập GitHub (callback: <BETTER_AUTH_URL>/api/auth/callback/github) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Đăng nhập ORCID (callback: <BETTER_AUTH_URL>/api/auth/callback/orcid) ---
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_ENV=                     # "sandbox" để thử

# --- Trợ lý AI (tuỳ chọn). Không có khoá: chế độ cục bộ ---
ANTHROPIC_API_KEY=
HCE_MODEL=claude-sonnet-5-5

# --- CSDL SQLite (mặc định data/hce.db) ---
# HCE_DB_PATH=

# --- Viết nghiên cứu (/tools/writium) — dịch vụ PO-Studio chạy riêng (xem po-studio/README.md, docs/TRIEN-KHAI-RENDER.md mục 8) ---
# Địa chỉ nội bộ của PO-Studio; để trống = mục Viết nghiên cứu chỉ soạn nháp, nút gửi bị khoá.
POSTUDIO_URL=
# Chuỗi bí mật dùng chung, phải trùng POSTUDIO_BRIDGE_TOKEN bên PO-Studio (chặn người ngoài gọi thẳng dịch vụ).
POSTUDIO_BRIDGE_TOKEN=
# Trùng POSTUDIO_ACCESS_CODE bên PO-Studio; chỉ cần khi cho người dùng đăng nhập dùng khoá AI chung.
POSTUDIO_ACCESS_CODE=
# "1" = người đã đăng nhập được dùng khoá AI của PO-Studio (ANTHROPIC_API_KEY... đặt bên dịch vụ PO-Studio).
PAPER_SERVER_KEY=0
# Hạn mức bản thảo/ngày: khách, tài khoản, và số lần dùng khoá chung/tài khoản.
PAPER_GUEST_DAILY_LIMIT=2
PAPER_USER_DAILY_LIMIT=5
PAPER_SERVER_KEY_DAILY_LIMIT=1
PAPER_MAX_UPLOAD_MB=40
