# At least one provider key (or let users paste their own key in the form)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Protects the server's keys: users without their own key must enter this code
POSTUDIO_ACCESS_CODE=change-me
# Polite-pool contact for OpenAlex; optional Semantic Scholar key
OPENALEX_MAILTO=you@example.edu
SEMANTIC_SCHOLAR_API_KEY=
POSTUDIO_MAX_JOBS=2
# Shared secret with the hi.hue.vn bridge (/api/paper/*): every /api/* call must carry X-Bridge-Token
POSTUDIO_BRIDGE_TOKEN=
# "1" enables the offline "mock" model (fake text + fake references) for demos/tests only — never in production
POSTUDIO_ENABLE_MOCK=0
